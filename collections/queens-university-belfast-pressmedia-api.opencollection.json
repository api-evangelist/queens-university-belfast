          "docs": "Get a list of allowed subdivisions for media coverages on Press/Media"
        },
        {
          "info": {
            "name": "A list of allowed Press/Media types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pure.qub.ac.uk/ws/api/pressmedia/allowed-types"
