          "docs": "Get a list of classifications that can be used when submitting a type."
        },
        {
          "info": {
            "name": "A list of allowed workflow steps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pure.qub.ac.uk/ws/api/person-expertises/allowed-workflow-steps"
