{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pure activity semester API",
    "version": "5.35.3-4"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "semester",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Lists all semesters",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pure.qub.ac.uk/ws/api/semesters",
            "params": [
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Number of returned semesters per request."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The offset for the returned list. 0 or null value is from the start"
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "The order of the list, must be a value from /semesters/orderings"
              }
            ]
          },
          "docs": "Lists all semesters in the Pure instance. If you need to filter the semesters returned, see the POST version which supports additional filtering."
        },
        {
          "info": {
            "name": "Create semester",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://pure.qub.ac.uk/ws/api/semesters",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create semester"
        },
        {
          "info": {
            "name": "A list of allowed locales in localized strings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pure.qub.ac.uk/ws/api/semesters/allowed-locales"
          },
          "docs": "Get a list of allowed locales that can be used when submitting localized string entities."
        },
        {
          "info": {
            "name": "Lists available orderings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pure.qub.ac.uk/ws/api/semesters/orderings"
          },
          "docs": "Lists all orderings available to the semester endpoint. These values can be used by the order parameter."
        },
        {
          "info": {
            "name": "Query operation for semester",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://pure.qub.ac.uk/ws/api/semesters/search",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Lists semesters in the Pure instance that matches the provided query, similar to the GET version, instead of using parameters to alter the response, an JSON document is posted with the request. The JSON document contains fields for all the parameters available for the GET version, but also additional filtering options."
        },
        {
          "info": {
            "name": "Get semester",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pure.qub.ac.uk/ws/api/semesters/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "UUID of the desired semester"
              }
            ]
          },
          "docs": "Get semester with specific UUID."
        },
        {
          "info": {
            "name": "Update semester",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://pure.qub.ac.uk/ws/api/semesters/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "UUID of the semester to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update semester with specific UUID."
        },
        {
          "info": {
            "name": "Delete semester",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://pure.qub.ac.uk/ws/api/semesters/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "UUID of the semester"
              }
            ]
          },
          "docs": "Delete semester with specific UUID."
        },
        {
          "info": {
            "name": "Lock the content",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://pure.qub.ac.uk/ws/api/semesters/:uuid/actions/lock",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "UUID of the content to lock"
              }
            ]
          },
          "docs": "Mark the content as external (used when content contains synchronised data). This has no effect on interactions with the content through the API."
        },
        {
          "info": {
            "name": "Unlock the content",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://pure.qub.ac.uk/ws/api/semesters/:uuid/actions/unlock",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "UUID of the content to unlock"
              }
            ]
          },
          "docs": "Remove the external mark on the content (used when content contains synchronised data). This has no effect on interactions with the content through the API."
        },
        {
          "info": {
            "name": "Lists all dependents to the semester",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pure.qub.ac.uk/ws/api/semesters/:uuid/dependents",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "UUID of the semester"
              },
              {
                "name": "verbose",
                "value": "",
                "type": "query",
                "description": "DEPRECATED - Parameter has no effect."
              }
            ]
          },
          "docs": "Lists all dependents to the semester with the specified UUID. If the user does not have access to view all the dependent content, an authorization error will be thrown. "
        }
      ]
    }
  ],
  "bundled": true
}