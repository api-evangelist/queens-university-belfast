{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pure activity concept API",
    "version": "5.35.3-4"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "concept",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Lists all concept",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pure.qub.ac.uk/ws/api/concepts",
            "params": [
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Number of returned concept per request."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The offset for the returned list. 0 or null value is from the start"
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "The order of the list, must be a value from /concept/orderings"
              }
            ]
          },
          "docs": "Lists all concept in the Pure instance. If you need to filter the concept returned, see the POST version which supports additional filtering."
        },
        {
          "info": {
            "name": "A list of allowed locales in localized strings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pure.qub.ac.uk/ws/api/concepts/allowed-locales"
          },
          "docs": "Get a list of allowed locales that can be used when submitting localized string entities."
        },
        {
          "info": {
            "name": "Query operation for concept",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://pure.qub.ac.uk/ws/api/concepts/search",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Lists concept in the Pure instance that matches the provided query, similar to the GET version, instead of using parameters to alter the response, an JSON document is posted with the request. The JSON document contains fields for all the parameters available for the GET version, but also additional filtering options."
        },
        {
          "info": {
            "name": "Get concept",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pure.qub.ac.uk/ws/api/concepts/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "UUID of the desired concept"
              }
            ]
          },
          "docs": "Get concept with specific UUID."
        }
      ]
    }
  ],
  "bundled": true
}